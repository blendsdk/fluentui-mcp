# ============================================================================
# FluentUI MCP — Enhancer / Pipeline environment variables
# ----------------------------------------------------------------------------
# Copy this file to `.env` and fill in your values:
#
#   cp .env.example .env
#
# `.env` is gitignored and is auto-loaded by the `yarn scrape` and
# `yarn enhance` scripts (via `node --env-file-if-exists=.env`).
# Requires Node.js >= 20.12 for the `--env-file-if-exists` flag.
# ============================================================================

# Which LLM provider to use for the enhancer. Required.
# Allowed values: openai | anthropic
LLM_PROVIDER=anthropic

# API key for the selected provider. Provide the one matching LLM_PROVIDER.
# Only the key for the active provider is read.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional: override the default model for the selected provider.
# Examples:
#   anthropic -> claude-3-5-sonnet-latest
#   openai    -> gpt-4o
# LLM_MODEL=claude-3-5-sonnet-latest

# Optional: number of concurrent LLM requests during enhancement (default: 3).
# LLM_CONCURRENCY=3

# Optional: maximum retry attempts per LLM request on transient failures.
# LLM_MAX_RETRIES=3
