{
  "name": "fluentui-skill",
  "version": "1.3.1",
  "description": "Agent Skill that teaches AI coding assistants Microsoft FluentUI React v9 with component, category, recipe, and API references installed into Claude Code and compatible agents.",
  "type": "module",
  "bin": {
    "fluentui": "dist/bin.js"
  },
  "files": [
    "dist/",
    "skills/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "watch": "tsc --watch",
    "test": "vitest run",
    "test:release": "node --test scripts/release.spec.test.mjs",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf dist",
    "assemble": "node --import tsx scripts/skill/assemble.ts",
    "verify": "npm run typecheck && npm test && npm run test:release && npm run check:version && npm run gate:skill",
    "check:version": "node scripts/check-version.mjs",
    "gate:skill": "npm run skill:check && npm run skill:validate && npm run skill:freshness && npm run skill:secrets",
    "prepack": "npm run clean && npm run build && npm run assemble",
    "prepublishOnly": "npm run verify",
    "ncu": "ncu -u && rm -fR node_modules package-lock.json && npm install && npm run clean && npm run build && npm test",
    "scrape": "node --env-file-if-exists=.env --import tsx scripts/scraper/cli.ts",
    "enhance": "node --env-file-if-exists=.env --import tsx scripts/enhancer/cli.ts",
    "skill:generate": "node --import tsx scripts/skill/generate.ts",
    "skill:check": "node --import tsx scripts/skill/check-drift.ts",
    "skill:validate": "node --import tsx scripts/skill/validate-examples.ts",
    "skill:freshness": "node --import tsx scripts/skill/check-freshness.ts",
    "skill:secrets": "node --import tsx scripts/skill/secrets.ts",
    "pipeline:full": "npm run scrape -- --version v9 --clone --verbose && npm run enhance -- --version v9 --full --verbose && npm run build && npm test"
  },
  "keywords": [
    "fluentui",
    "fluent-ui",
    "microsoft",
    "react",
    "react-components",
    "documentation",
    "agent-skill",
    "claude-code",
    "copilot",
    "llm",
    "design-system",
    "ui-components",
    "developer-tools"
  ],
  "author": "blendsdk",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blendsdk/fluentui-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/blendsdk/fluentui-mcp/issues"
  },
  "homepage": "https://github.com/blendsdk/fluentui-mcp#readme",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@fluentui/react-components": "^9.74.7",
    "@fluentui/react-icons": "^2.0.341",
    "@types/node": "^25.2.1",
    "@types/react": "^19.3.0",
    "npm-check-updates": "^19.3.2",
    "react": "^19.3.0",
    "ts-morph": "^28.0.0",
    "tsx": "^4.19.4",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
